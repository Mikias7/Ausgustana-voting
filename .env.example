# Copy to server/.env and fill in. Never commit real values.

NODE_ENV=development
PORT=3000

# PostgreSQL connection (Prisma)
DATABASE_URL=postgresql://asa_voting:CHANGE_ME@localhost:5432/asa_voting
# Separate database used by automated tests (it is wiped between runs)
TEST_DATABASE_URL=postgresql://asa_voting:CHANGE_ME@localhost:5432/asa_voting_test

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME

# "dev" = sign-in-as picker (development only; server refuses to start with this in production)
AUTH_MODE=dev

# Comma-separated email domains accepted by the roster import
ALLOWED_EMAIL_DOMAINS=ole.augie.edu

# Dev only: URL of the Vite dev server (used for CORS in development)
CLIENT_ORIGIN=http://localhost:5173
